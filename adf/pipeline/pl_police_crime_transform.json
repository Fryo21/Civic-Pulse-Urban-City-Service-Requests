			{
				"name": "load_gold_tables",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "if_postgres_month_exists",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "AzurePostgreSql1",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "NonQuery",
							"text": "-- ============================================================\r\n-- 1. REMOVE DUPLICATE STAGING RECORDS\r\n-- Keep one row per crime_id\r\n-- ============================================================\r\n\r\nWITH ranked AS (\r\n    SELECT\r\n        ctid,\r\n        ROW_NUMBER() OVER (\r\n            PARTITION BY crime_id\r\n            ORDER BY ctid\r\n        ) AS rn\r\n    FROM public.stg_crime\r\n)\r\nDELETE FROM public.stg_crime s\r\nUSING ranked r\r\nWHERE s.ctid = r.ctid\r\n  AND r.rn > 1;\r\n\r\n\r\n-- ============================================================\r\n-- 2. CRIME TYPE DIMENSION\r\n-- ============================================================\r\n\r\nINSERT INTO public.dim_crime_type (category)\r\nSELECT DISTINCT s.category\r\nFROM public.stg_crime s\r\nWHERE s.category IS NOT NULL\r\n  AND NOT EXISTS (\r\n      SELECT 1\r\n      FROM public.dim_crime_type d\r\n      WHERE d.category = s.category\r\n  );\r\n\r\n\r\n-- ============================================================\r\n-- 3. LOCATION DIMENSION\r\n-- ============================================================\r\n\r\nINSERT INTO public.dim_location (\r\n    street_name,\r\n    latitude,\r\n    longitude\r\n)\r\nSELECT DISTINCT\r\n    s.street_name,\r\n    s.latitude,\r\n    s.longitude\r\nFROM public.stg_crime s\r\nWHERE NOT EXISTS (\r\n    SELECT 1\r\n    FROM public.dim_location d\r\n    WHERE d.street_name = s.street_name\r\n      AND d.latitude = s.latitude\r\n      AND d.longitude = s.longitude\r\n);\r\n\r\n\r\n-- ============================================================\r\n-- 4. DATE DIMENSION\r\n-- ============================================================\r\n\r\nINSERT INTO public.dim_date (\r\n    month_date,\r\n    year,\r\n    month_number,\r\n    month_name\r\n)\r\nSELECT DISTINCT\r\n    MAKE_DATE(s.year, s.month, 1),\r\n    s.year,\r\n    s.month,\r\n    TO_CHAR(MAKE_DATE(s.year, s.month, 1), 'FMMonth')\r\nFROM public.stg_crime s\r\nON CONFLICT (month_date) DO NOTHING;\r\n\r\n\r\n-- ============================================================\r\n-- 5. POLICE FORCE DIMENSION\r\n-- ============================================================\r\n\r\nINSERT INTO public.dim_police_force (police_force_name)\r\nVALUES ('Metropolitan Police Service')\r\nON CONFLICT (police_force_name) DO NOTHING;\r\n\r\n\r\n-- ============================================================\r\n-- 6. FACT TABLE\r\n-- ============================================================\r\n\r\nINSERT INTO public.fact_crime (\r\n    crime_id,\r\n    crime_type_key,\r\n    location_key,\r\n    date_key,\r\n    police_force_key\r\n)\r\nSELECT\r\n    s.crime_id,\r\n    ct.crime_type_key,\r\n    l.location_key,\r\n    d.date_key,\r\n    pf.police_force_key\r\nFROM public.stg_crime s\r\nJOIN public.dim_crime_type ct\r\n    ON s.category = ct.category\r\nJOIN public.dim_location l\r\n    ON s.street_name = l.street_name\r\n    AND s.latitude = l.latitude\r\n    AND s.longitude = l.longitude\r\nJOIN public.dim_date d\r\n    ON MAKE_DATE(s.year, s.month, 1) = d.month_date\r\nCROSS JOIN public.dim_police_force pf\r\nWHERE pf.police_force_name = 'Metropolitan Police Service'\r\nON CONFLICT (crime_id) DO NOTHING;"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			}
		],
